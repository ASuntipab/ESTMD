<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the Manday Estimation app.

  The app is a Node.js server (see install-service.ps1) listening on
  127.0.0.1:3100. IIS only forwards requests to it. Requires these IIS modules:
    - URL Rewrite 2.1
    - Application Request Routing (ARR) 3.0, with the proxy enabled

  Place this file in the IIS site (or application) root.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Let IIS answer its own health probe without touching the app. -->
        <rule name="IIS health probe" stopProcessing="true">
          <match url="^iisstart\.htm$" />
          <action type="None" />
        </rule>

        <rule name="Reverse proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:1}" />
          <serverVariables>
            <!-- The app builds absolute URLs and redirects from these. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>

      <outboundRules>
        <!-- Keep Set-Cookie and Location headers pointing at the public host. -->
        <rule name="Rewrite Location header" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location"
                 pattern="^http://127\.0\.0\.1:3100/(.*)" />
          <action type="Rewrite" value="https://{HTTP_HOST}/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3\d\d" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Uploads are not used, but Server Action payloads can be sizeable. -->
        <requestLimits maxAllowedContentLength="20971520" />
        <hiddenSegments>
          <!-- Belt and braces: never serve these even if the proxy is bypassed. -->
          <add segment="data" />
          <add segment="node_modules" />
          <add segment=".next" />
          <add segment="drizzle" />
          <add segment="scripts" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".xlsx" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- The site serves nothing itself; everything is proxied. -->
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

  </system.webServer>
</configuration>
